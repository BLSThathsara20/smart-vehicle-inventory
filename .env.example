# Firebase (Authentication) — Project Settings in Firebase Console
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Web Push (FCM) — Firebase Console → Project settings → Cloud Messaging → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=

# Sanity — Project ID, dataset, API version, and token with Editor (writes). Viewer/read-only tokens return 403 on add vehicle.
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-01-01
VITE_SANITY_TOKEN=

# Public “book a viewing” (/book/vehicle/:id)

# Easiest — no backend: enquiries go to your inbox (customer taps Send in their mail app). Does NOT write Sanity.
# VITE_PUBLIC_BOOKING_EMAIL=enquiries@your-dealership.example

# Optional: HTTPS POST (e.g. Firebase submitPublicViewingBooking) saves into Sanity server-side — see functions/README.md
# VITE_PUBLIC_VIEWING_BOOKING_URL=https://us-central1-YOUR_PROJECT.cloudfunctions.net/submitPublicViewingBooking

# ImgBB — https://api.imgbb.com/ (upload key; never commit the real key)
VITE_IMGBB_API_KEY=

# Optional: header text on exported PDI PDF (default ASAHIMOTORS UK GROUP)
# VITE_PDI_BRAND_LINE=
